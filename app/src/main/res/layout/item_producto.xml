<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="7dp"
    android:background="@drawable/bg_tarjeta"
    android:orientation="vertical"
    android:padding="7dp">

    <ImageView
        android:id="@+id/iv_producto"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/producto_imagen" />

    <!-- Contenedor del nombre, precio y favorito -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Nombre y precio -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_nombre_producto"
                style="@style/TextoProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start" />

            <TextView
                android:id="@+id/tv_precio_producto"
                style="@style/TextoPrecios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="start" />

        </LinearLayout>

        <!-- Icono de favoritos -->
        <ImageView
            android:id="@+id/iv_favorito"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/corazon"
            android:contentDescription="@string/favoritos" />

    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    tools:context=".CatalogoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <!-- Barra de búsqueda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_busqueda"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/menu"
                android:contentDescription="Menú" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Buscar..."
                style="@style/TextoBusqueda" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/lupa"
                android:contentDescription="Buscar" />

        </LinearLayout>

        <!-- Encabezado Catálogo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="21dp"
            android:background="@color/fondo_encabezado"
            android:text="Catálogo"
            android:gravity="center"
            style="@style/TextoTitulo" />

        <!-- Contenedor de filtros -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Filtro Edad/Talla -->
            <TextView
                android:id="@+id/filtro_edad_talla"
                android:layout_width="100dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_filtro"
                android:text="@string/filtro_edad_talla"
                style="@style/TextoFiltros" />

            <!-- Filtro Color -->
            <TextView
                android:id="@+id/filtro_color"
                android:layout_width="66dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_filtro"
                android:text="@string/filtro_color"
                style="@style/TextoFiltros" />

            <!-- Filtro Precio -->
            <TextView
                android:id="@+id/filtro_precio"
                android:layout_width="73dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_filtro"
                android:text="@string/filtro_precio"
                style="@style/TextoFiltros" />

            <!-- Filtro Ordenar -->
            <TextView
                android:id="@+id/filtro_ordenar"
                android:layout_width="83dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_filtro"
                android:text="@string/filtro_ordenar"
                style="@style/TextoFiltros" />

        </LinearLayout>


        <!-- Cantidad de productos y ordenación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Cantidad de productos -->
            <TextView
                android:id="@+id/tv_cantidad_productos"
                style="@style/TextoFiltros"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="@string/cantidad_productos"
                android:textColor="@color/on_surface_variant" />

            <!-- Zona de ordenar -->
            <LinearLayout
                android:id="@+id/contenedor_ordenar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ordenar_por"
                    style="@style/TextoFiltros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ordenar_por"
                    android:textColor="@color/on_surface_variant" />

                <ImageView
                    android:id="@+id/iv_flecha_ordenar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ordenar"
                    android:contentDescription="@string/ordenar_por" />

            </LinearLayout>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_productos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="24dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- Barra de navegación inferior fija -->
    <include
        android:id="@+id/barra_navegacion"
        layout="@layout/layout_navegacion"
        android:layout_width="0dp"
        android:layout_height="80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
